# Copy this file to .env and fill in the values. Never commit .env.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: webhook ID from the PayPal dashboard. If set, webhook signatures are verified.
PAYPAL_WEBHOOK_ID=
# Optional: email of the sandbox business account that sends the invoices.
PAYPAL_INVOICER_EMAIL=

GEMINI_API_KEY=
# Comma-separated list. The app tries each model in order until one answers.
GEMINI_MODEL=gemini-flash-latest,gemini-3.8-flash,gemini-3.5-flash-lite,gemini-2.5-flash

# Set both to 1 to run with no keys (demo data, rule-based agent).
PAYPAL_MOCK=0
AGENT_MOCK=0

# Anti-spam policy for payment reminders.
REMINDER_COOLDOWN_MINUTES=60
REMINDER_MAX=3

# Where the "Contact support" button goes. A GitHub "new issue" URL or a mailto: address.
SUPPORT_URL=https://github.com/starlord-93/paypal-invoice-agent/issues/new
