# Copy this file to .env and fill in the values. Never commit .env.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: webhook ID from the PayPal dashboard. If set, webhook signatures are verified.
PAYPAL_WEBHOOK_ID=
# Optional: email of the sandbox business account that sends the invoices.
PAYPAL_INVOICER_EMAIL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Set both to 1 to run with no keys (demo data, rule-based agent).
PAYPAL_MOCK=0
AGENT_MOCK=0
